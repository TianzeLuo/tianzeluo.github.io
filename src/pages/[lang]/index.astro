---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ResearchVisual from '../../components/ResearchVisual.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/profile';
import { languages, ui, type Lang } from '../../i18n/ui';
import { path, otherLang } from '../../i18n/utils';
export const getStaticPaths = () => languages.map(lang => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const projects = (await getCollection('projects', ({data}) => data.lang === lang && !data.draft && data.featured)).sort((a,b) => a.data.order - b.data.order).slice(0,3);
const interests = lang === 'en' ? [
  ['Open-source tools', 'Turning what I learn into software I can share.'],
  ['Research & engineering', 'Building things for real questions.'],
  ['Current interests', 'Generative models and agent systems.']
] : [
  ['开源工具', '把学到的东西做成可以分享的软件。'],
  ['研究与工程', '为真实问题构建东西。'],
  ['目前关注', '生成模型与 Agent 系统。']
];
---
<BaseLayout lang={lang} title={lang === 'en' ? 'Open-source tools & projects' : '开源工具与项目'} active="home" alternate={path(otherLang(lang))}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">{lang === 'en' ? 'Hello, I’m' : '你好，我是'}<span>{profile.name[lang]}{lang === 'en' ? '.' : '。'}</span></h1>
        <p class="about">{profile.about[lang]}</p>
        <div class="hero-actions"><a class="button primary" href={path(lang,'projects')}>{lang === 'en' ? 'Explore my projects' : '查看我的项目'}<Icon name="right" size={16}/></a><a class="button" href={path(lang,'cv')}><Icon name="document" size={16}/>{lang === 'en' ? 'View CV' : '查看简历'}</a>{profile.github && <a class="button" href={profile.github} rel="noopener noreferrer" target="_blank"><Icon name="github" size={16}/>GitHub</a>}{profile.email && <a class="button" href={`mailto:${profile.email}`}><Icon name="mail" size={16}/>{lang === 'en' ? 'Email' : '邮箱'}</a>}</div>
      </div>
      <div class="hero-art"><ResearchVisual large/><div class="art-label"><span>BUILD → SHARE</span><span>CONCEPTUAL VIEW</span></div></div>
    </section>
    <section class="interest-strip" aria-label={lang === 'en' ? 'Focus' : '关注方向'}>{interests.map(([title, desc], i) => <div class="interest-item"><span class="interest-number">0{i+1}</span><div><h3>{title}</h3><p>{desc}</p></div></div>)}</section>
    <section class="section" aria-labelledby="selected-projects"><div class="section-heading"><div><h2 id="selected-projects">{t.selectedProjects}<span>01</span></h2><p>{t.projectsSubtitle}</p></div><a class="text-link" href={path(lang,'projects')}>{t.viewAll}<Icon name="right" size={16}/></a></div><div class="project-grid">{projects.map(entry => <ProjectCard entry={entry} lang={lang}/>)}</div></section>
    <section class="contact-section"><div><h2>{t.contactTitle}</h2><p>{t.contactText}</p></div><div class="contact-actions">{profile.email ? <a class="button" href={`mailto:${profile.email}`}>{t.contact}<Icon name="arrow" size={16}/></a> : <span class="contact-pending"><Icon name="mail" size={15}/>{t.contactPending}</span>}{profile.github && <a class="button" href={profile.github} rel="noopener noreferrer" target="_blank"><Icon name="github" size={15}/>GitHub</a>}</div></section>
  </div>
</BaseLayout>
