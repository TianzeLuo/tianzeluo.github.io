---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import SampleNotice from '../components/SampleNotice.astro';
import Icon from '../components/Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import { path } from '../i18n/utils';
interface Props { lang: Lang; title: string; summary: string; section: 'research'|'projects'|'writing'; updated: Date; tags: string[]; status: 'ongoing'|'completed'|'archived'; sample: boolean; alternate: string; translated: boolean; headings: MarkdownHeading[]; links: Record<string,string|undefined>; }
const { lang, title, summary, section, updated, tags, status, sample, alternate, translated, headings, links } = Astro.props;
const t = ui[lang];
---
<BaseLayout lang={lang} title={title} description={summary} active={section} alternate={alternate} translated={translated}>
  <div class="container article-top"><a class="text-link" href={path(lang,section)}><Icon name="back" size={15}/>{t.back} {t[section]}</a>
    <header class="article-heading"><span class="eyebrow">{t[section]}</span><h1>{title}</h1><p>{summary}</p><div class="article-meta"><span>{sample ? t.demo : t[status]}</span><span>{t.updated} {updated.toISOString().slice(0,10)}</span></div><div class="tags">{tags.map(tag => <span>{tag}</span>)}</div>{sample && <SampleNotice lang={lang} compact/>}</header>
    <div class="article-layout"><div class="article-content"><div class="prose"><slot/></div>{Object.values(links).some(Boolean) && <section class="cv-section"><h2>{t.resources}</h2><div class="resource-links">{Object.entries(links).filter(([,url])=>url).map(([key,url])=><a class="button" href={url} rel="noopener noreferrer" target="_blank">{t[key as 'code'|'paper'|'live'|'website']}<Icon name="arrow" size={14}/></a>)}</div></section>}</div><aside class="toc"><h2>{t.contents}</h2>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</aside></div>
  </div>
</BaseLayout>
