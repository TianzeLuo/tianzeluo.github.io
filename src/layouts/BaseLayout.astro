---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Lang } from '../i18n/ui';
import { asset } from '../i18n/utils';
import { profile } from '../data/profile';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { lang: Lang; title: string; description?: string; active?: string; alternate?: string; translated?: boolean; }
const { lang, title, description = profile.intro[lang], active = 'home', alternate, translated = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const alternateUrl = Astro.site && alternate && translated ? new URL(alternate, Astro.site).href : undefined;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="dark" data-placeholder={String(profile.isPlaceholder)}>
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/>
    <meta name="generator" content={Astro.generator}/><title>{title} — {profile.name[lang]}</title>
    <meta name="description" content={description}/><meta name="color-scheme" content="dark light"/>
    <meta name="theme-color" content="#0c111b"/>
    {profile.isPlaceholder && <meta name="robots" content="noindex, nofollow"/>}
    {canonical && <link rel="canonical" href={canonical}/>}
    {canonical && <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonical}/>}
    {alternateUrl && <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternateUrl}/>}
    <meta property="og:type" content="website"/><meta property="og:title" content={`${title} — ${profile.name[lang]}`}/><meta property="og:description" content={description}/>
    {canonical && <meta property="og:url" content={canonical}/>}
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'}/>
    <script is:inline>
      try { const saved = localStorage.getItem('portfolio-theme'); document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark'; } catch {}
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} active={active} alternate={alternate}/>
    <main id="main"><slot/></main>
    <Footer lang={lang}/>
  </body>
</html>
